#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin >> t;
    while(t--){
        vector<vector<char>>s(10,vector<char>(10));
        for(int i=0;i<10;i++){
            for(int j=0;j<10;j++) cin>>s[i][j];
        }
        int ans=0;
        for(int i=0;i<10;i++){
            for(int j=0;j<10;j++){
                if(s[i][j]=='X') {
                    if((i>3&&i<6)&&(j>3&&j<6)) ans+=5;
                    else if((i>2&&i<7)&&(j>2&&j<7)) ans+=4;
                    else if((i>1&&i<8)&&(j>1&&j<8)) ans+=3;
                    else if((i>0&&i<9)&&(j>0&&j<9)) ans+=2;
                    else ans+=1;
                }
            }
        }
        cout<<ans<<"\n";
    }return 0;
}