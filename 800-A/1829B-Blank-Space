#include<bits/stdc++.h>
using namespace std;

const long long MOD=1e9+7;

int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n);
        int ans=0;  
        for(int i=0;i<n;i++) {
            cin>>a[i];
        }
        int x=0;
        for(int i=0;i<n;i++){
            if(a[i]==0) x++;
            else{
                ans=max(ans,x);
                x=0;
            }
        }ans=max(ans,x);
        cout<<ans<<"\n";
    }
    return 0;
}