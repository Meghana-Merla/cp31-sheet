#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n);
        int sum=0, pro=1;
        for(int i=0;i<n;i++) {
            cin>>a[i];
            sum+=a[i];
            pro*=a[i];
        }
        int ans=0;
        while(sum<0){
            sum+=2;
            ans++;
            pro*=-1;
        }
        if(pro>0) cout<<ans<<"\n";
        else cout<<ans+1<<"\n";
    }
    return 0;
}