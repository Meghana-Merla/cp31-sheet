#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n);
        
        for(int i=0;i<n;i++) 
            cin>>a[i];
        vector<int>b(a.begin(),a.end());
        sort(b.begin(),b.end());
        if(b!=a) cout<<"0 \n";
        else{
            int mn=INT_MAX;
            for(int i=0;i<n-1;i++){
                mn=min(mn,abs(a[i]-a[i+1]));
            }
            cout<<(mn+2)/2<<"\n";
        }
    }
    return 0;
}