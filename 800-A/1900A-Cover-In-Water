#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin >> t;
    while(t--){
        int n;
        cin>>n;
        string s;
        cin>>s;
        int x=0;
        for(char ch:s){
            if(ch=='.') x++;
        }
        bool ok=false;
        if(s.size()>2){
            for(int i=0;i<n-1;i++){
                if(s[i]=='.'&&s[i+1]=='.'&&s[i+2]=='.') ok=true;
            }
        }
        if(ok) cout<<"2 \n";
        else cout<<x<<"\n";
    }return 0;
}