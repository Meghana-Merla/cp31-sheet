#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin >> t;
    while(t--){
        int n;        
        cin>>n;
        vector<int>a(n);
        long long ans=0;
        for(int i=0;i<n;i++){
            cin>>a[i];
            ans+=a[i];
        }
        cout<<-1*ans<<"\n";
    }return 0;
}