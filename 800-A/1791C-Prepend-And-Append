#include<bits/stdc++.h>
using namespace std;

const long long MOD=1e9+7;

int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        string s;
        cin>>s;
        int i=0,j=s.size()-1;
        while(i<j){
            if(s[i]!=s[j]) break;
            i++;
            j--;
        }
        cout<<j-i+1<<"\n";
    }
    return 0;
}