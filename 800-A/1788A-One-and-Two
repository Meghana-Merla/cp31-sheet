#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int cnt=0;
        vector<int>a(n);
        for(int i=0;i<n;i++) {
            cin>>a[i];
            if(a[i]==2) cnt++;
        }
        if(cnt%2==0){
            int x=cnt/2;
            for(int i=0;i<n;i++){
                if(a[i]==2) x--;
                if(x==0){
                    cout<<i+1<<"\n";
                    break;
                }
            }
        }
        else cout<<"-1 \n";
        
    }
    return 0;
}