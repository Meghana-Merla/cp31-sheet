#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin >> t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n);
        for(int i=0;i<n;i++) cin>>a[i];
        set<int>s(a.begin(),a.end());
        if(s.size()<3){
            if(s.size()==1) cout<<"YES \n";
            else if(s.size()==2){
                vector<int>v(s.begin(),s.end());
                int x=0,y=0;
                for(int i=0;i<n;i++){
                    if(a[i]==v[0]) x++;
                    else y++;
                }
                if(abs(x-y)<=1) cout<<"YES \n";
                else cout<<"NO \n";
            }
        }
        else cout<<"NO \n";
    }return 0;
}