#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

void meghana(){
    int n;
    cin>>n;
    vector<int> a(n);
    for(int &x:a) cin>>x;
    for(int i=0;i<n-2;i++){
        if(a[i]>a[i+1] && a[i]>a[i+2]){
            cout<<"YES\n";
            cout<<i+1<<" "<<i+2<<" "<<i+3<<"\n";
            return;
        }
    }
    cout<<"NO\n";
}

int main(){
    int t;
    cin>>t;
    while(t--){
        meghana();
    }
    return 0;
}