#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
        string s;
        cin>>s;
        int one=0, zero=0;
        for(char ch:s){
            if(ch=='1') one++;
            else zero++;
        }
        int x=min(one, zero);
        if(x%2==0) cout<<"NET\n";
        else cout<<"DA\n";
    }
    return 0;
}