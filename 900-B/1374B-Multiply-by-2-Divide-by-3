#include<bits/stdc++.h>
#include<algorithm>
using namespace std;

int main(){
    int t;
    cin>>t;
    while(t--){
        long long n;
        cin>>n;
        
        int cnt=0;
        while(n!=1){
            if(n%6==0){
                n/=6;
                cnt++;
            }else if(n%3==0){
                n*=2;
                cnt++;
            }else{
                cout<<-1<<"\n";
                break;
            }
        }if(n==1) cout<<cnt<<"\n";
        
    }
    return 0;
}